{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.3.0",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed",
  "default_locale": "en"
}
